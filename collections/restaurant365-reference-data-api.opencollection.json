          "info": {
            "name": "List Companies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://odata.restaurant365.net/api/v2/views/Company",
            "params": [
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "Boolean expression used to filter results"
              },
              {
                "name": "$orderby",
                "value": "",
                "type": "query",
                "description": "Property to sort by; append desc for descending order"
              },
              {
                "name": "$select",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of properties to return"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "List all companies (vendors) in the customer database."
        },
