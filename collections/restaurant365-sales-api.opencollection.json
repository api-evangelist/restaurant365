      "items": [
        {
          "info": {
            "name": "List Sales Employee Tickets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://odata.restaurant365.net/api/v2/views/SalesEmployee",
            "params": [
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "Boolean expression used to filter results"
              },
              {
                "name": "$orderby",
                "value": "",
                "type": "query",
                "description": "Property to sort by; append desc for descending order"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve sales ticket header data. This view does not support $select or $count and is limited to a 31-day date range per request."
        },
        {
